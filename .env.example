# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GETSETYO_API_URL: Custom endpoint URL for the GetSetYo itinerary creation API (optional, defaults to https://www.getsetyo.club/itinerary/generate-ai-itinerary)
GETSETYO_API_URL="https://www.getsetyo.club/itinerary/generate-ai-itinerary"

# GETSETYO_COOKIE: Session cookie string loaded with valid JWT and device tokens for authenticating against the GetSetYo backend APIs (legacy)
GETSETYO_COOKIE=""

# GETSETYO_JWT_TOKEN: Session JWT token used for authenticating API requests
GETSETYO_JWT_TOKEN=""

# GETSETYO_LOGIN_SESSION_TOKEN: Login session token used in cookies
GETSETYO_LOGIN_SESSION_TOKEN=""

# USE_REDIS: Enable the in-memory Redis-style cache for analysis results (optional, defaults to false).
# When false, every analysis runs fresh with no caching.
USE_REDIS="false"

# GENERATE_ITINERARY: Enable itinerary generation via GetSetYo API (optional, defaults to true).
# When "false", the pipeline will only generate recommendations without creating bookable trips.
GENERATE_ITINERARY="true"

# VITE_DEBUG_MODE: Show internal/debug UI surfaces in the frontend (optional, defaults to false).
# When "true", reveals the Agent Trace tab, Tech Specs tab, infra telemetry chips,
# and internal badges/scores/IDs (confidence %, match score %, deal IDs, statuses).
# Leave "false" for the end-user-facing experience.
VITE_DEBUG_MODE="false"
